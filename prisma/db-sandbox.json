        {
          "id": "node-phone",
          "flowId": "flow-nvdrzhd0z",
          "type": "phone_input",
          "x": 1350,
          "y": 50,
          "data": {
            "text": "Thanks! And what is your phone number?",
            "variable": "visitor_phone"
          }
        },
        {
          "id": "node-success",
          "flowId": "flow-nvdrzhd0z",
          "type": "message",
          "x": 1600,
          "y": 150,
          "data": {
            "text": "Thank you! Our team will reach out to you shortly."
          }
        },
        {
          "id": "node-later",
          "flowId": "flow-nvdrzhd0z",
          "type": "message",
          "x": 850,
          "y": 350,
          "data": {
            "text": "No worries! If you change your mind, we'll be right here. Have a great day!"
          }
        },
