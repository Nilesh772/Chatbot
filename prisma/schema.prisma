generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  password      String?
  name          String?
  image         String?
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  bots          Bot[]
  subscriptions Subscription[]

  @@map("users")
}

model Plan {
  id            String         @id
  name          String
  price         Decimal        @db.Decimal(10, 2)
  features      Json // Stored as array of strings
  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                 String   @id @default(uuid())
  userId             String   @map("user_id")
  planId             String   @map("plan_id")
  status             String // active, cancelled, etc.
  currentPeriodStart DateTime @map("current_period_start")
  currentPeriodEnd   DateTime @map("current_period_end")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

model Bot {
  id             String          @id @default(uuid())
  userId         String          @map("user_id")
  name           String
  avatarUrl      String?         @db.Text @map("avatar_url")
  welcomeMessage String?         @map("welcome_message") @db.Text
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  flows          Flow[]
  widgetSettings WidgetSettings?
  conversations  Conversation[]
  leads          Lead[]
  analytics      Analytics[]

  @@map("bots")
}

model Flow {
  id        String   @id @default(uuid())
  botId     String   @map("bot_id")
  name      String
  isMain    Boolean  @default(false) @map("is_main")
  nodes     Json     // React Flow nodes stored as JSON
  edges     Json     // React Flow edges stored as JSON
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  bot       Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@map("flows")
}

model WidgetSettings {
  id                     String   @id @default(uuid())
  botId                  String   @unique @map("bot_id")
  widgetColor            String   @default("#4F46E5") @map("widget_color")
  headerColor            String   @default("#4F46E5") @map("header_color")
  position               String   @default("bottom-right") // bottom-right, bottom-left
  bubbleStyle            String   @default("round") // round, square, icon
  font                   String   @default("Inter")
  borderRadius           Int      @default(12) @map("border_radius")
  launcherIcon           String?  @db.Text @map("launcher_icon")
  launcherBgTransparent  Boolean  @default(false) @map("launcher_bg_transparent")
  launcherIconSize       Int      @default(28) @map("launcher_icon_size")
  headerTextColor        String   @default("#FFFFFF") @map("header_text_color")
  leftMessageBgColor     String   @default("#F1F5F9") @map("left_message_bg_color")
  leftMessageTextColor  String   @default("#0F172A") @map("left_message_text_color")
  rightMessageBgColor    String   @default("#4F46E5") @map("right_message_bg_color")
  rightMessageTextColor String   @default("#FFFFFF") @map("right_message_text_color")
  widgetBgColor          String   @default("#FFFFFF") @map("widget_bg_color")
  launcherGreeting       String   @default("Hi! Need help? 👋") @map("launcher_greeting")
  launcherGreetingEnabled Boolean @default(true) @map("launcher_greeting_enabled")
  launcherAnimation      String   @default("bounce") @map("launcher_animation") // bounce, wiggle, pulse, none
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@map("widget_settings")
}

model Conversation {
  id        String    @id @default(uuid())
  botId     String    @map("bot_id")
  sessionId String    @map("session_id")
  variables Json?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  bot      Bot       @relation(fields: [botId], references: [id], onDelete: Cascade)
  messages Message[]
  lead     Lead?

  @@map("conversations")
}

model Message {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  sender         String // bot, user
  text           String   @db.Text
  payload        Json? // optional input data like form details, button clicked
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model Lead {
  id             String   @id @default(uuid())
  botId          String   @map("bot_id")
  conversationId String?  @unique @map("conversation_id")
  name           String?
  email          String?
  mobile         String?
  source         String?  @db.Text // domain or page url
  createdAt      DateTime @default(now()) @map("created_at")

  bot          Bot           @relation(fields: [botId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@map("leads")
}

model Analytics {
  id        String   @id @default(uuid())
  botId     String   @map("bot_id")
  metric    String // visitor, chat_start, lead_conversion, etc.
  value     Int      @default(1)
  metadata  Json? // optional additional info
  createdAt DateTime @default(now()) @map("created_at")

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@map("analytics")
}
